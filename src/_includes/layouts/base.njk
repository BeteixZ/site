<!DOCTYPE html>
<html lang="{{ lang | default('en') }}">
<head>
    {% include "layouts/components/head.njk" %}
    
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Bindow",
        "url": "https://bindow.top",
        "author": {
            "@type": "Person",
            "name": "Bindow",
            "url": "https://bindow.top"
        }
    }
    </script>
</head>
<body>
    <a href="#main-content" class="skip-link button">Skip to main content</a>

    <div class="main-wrapper">
        <main>
            <header class="main-title">
                <h1 class="site-title">
                    <a href="/">Bindow</a>
                </h1>
                <nav class="icons" aria-label="Social links">
                    <button class="theme-toggle" aria-label="Toggle color scheme" title="Toggle light/dark mode">
                        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path><path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path><path d="M2 12h2"></path><path d="M20 12h2"></path><path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path></svg>
                        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path></svg>
                    </button>
                    <a class="icon-link" href="https://github.com/BeteixZ" target="_blank" rel="noopener noreferrer" title="GitHub" aria-label="GitHub">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                        <span>GitHub</span>
                    </a>
                    <a class="icon-link" href="https://www.last.fm/user/Beteix" target="_blank" rel="noopener noreferrer" title="Last.fm" aria-label="Last.fm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"></path><path d="M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8z"></path></svg>
                        <span>Last.fm</span>
                    </a>
                </nav>
            </header>

            <button class="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Toggle navigation">
                <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
                <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
            </button>

            {% include "layouts/components/nav.njk" %}

            <div id="main-content" class="default-wrapper">
                {{ content | mark | safe }}
            </div>
        </main>

        {% include "layouts/components/footer.njk" %}
    </div>

    <script defer src="/js/music.js?v=records-1"></script>
    <script defer src="/js/theme.js"></script>
    <script>
    (function(){
      /* Back to top */
      var btn=document.createElement('button');
      btn.className='back-to-top';
      btn.setAttribute('aria-label','Back to top');
      btn.innerHTML='<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>';
      document.body.appendChild(btn);
      window.addEventListener('scroll',function(){
        btn.classList.toggle('visible',window.scrollY>400);
      },{passive:true});
      btn.addEventListener('click',function(){
        window.scrollTo({top:0,behavior:'smooth'});
      });

      /* Hamburger menu */
      var navToggle=document.querySelector('.nav-toggle');
      var primaryNav=document.querySelector('.primary');
      if(navToggle&&primaryNav){
        primaryNav.id='primary-nav';
        navToggle.addEventListener('click',function(){
          var expanded=navToggle.getAttribute('aria-expanded')==='true';
          navToggle.setAttribute('aria-expanded',String(!expanded));
          primaryNav.classList.toggle('is-open',!expanded);
        });
      }

      /* Sticky nav shadow */
      var nav=document.querySelector('.primary');
      if(nav){
        var observer=new IntersectionObserver(function(entries){
          entries.forEach(function(e){
            nav.classList.toggle('is-stuck',!e.isIntersecting);
          });
        },{threshold:1,rootMargin:'-1px 0px 0px 0px'});
        var sentinel=document.createElement('div');
        sentinel.style.height='1px';
        nav.parentNode.insertBefore(sentinel,nav);
        observer.observe(sentinel);
      }

      /* Reveal on scroll */
      var reveals=document.querySelectorAll('.recent-activity, .content-card, .media-panel, .media-card, .about-section, .co2-hero, .moon-panel, .apod-container, .iss-card');
      if('IntersectionObserver' in window){
        reveals.forEach(function(el){el.classList.add('reveal');});
        var ro=new IntersectionObserver(function(entries){
          entries.forEach(function(e){
            if(e.isIntersecting){
              e.target.classList.add('is-visible');
              ro.unobserve(e.target);
            }
          });
        },{threshold:0.08,rootMargin:'0px 0px -40px 0px'});
        reveals.forEach(function(el){ro.observe(el);});
      }
    })();
    </script>
</body>
</html>
